# aurum-verify-starter — copy to .env and fill in. Never commit a populated .env.
# Values here are placeholders, not credentials.

# Your receive-only address. Funds land here. REQUIRED in production mode.
VERIFY_PAY_TO=

# base-sepolia (testnet) or base (mainnet).
VERIFY_NETWORK=base-sepolia

# test = HMAC credential, no chain, no money. production = EIP-712 + facilitator.
VERIFY_PAID_MODE=test

# Price per call in USD. Converted to integer USDC atomic units (6 decimals).
VERIFY_PRICE_USD=0.05

# Public origin, used to build the absolute `resource` URL in challenges.
# Leave empty for local development.
VERIFY_PUBLIC_BASE_URL=

# Facilitator base URL. REQUIRED in production mode.
X402_FACILITATOR_URL=

# Gates GET /internal/revenue. Generate with: openssl rand -hex 32
VERIFY_ADMIN_TOKEN=

# Verifies POST /v1/stripe/webhook signatures.
STRIPE_WEBHOOK_SECRET=

# Local state: nonces, idempotency rows, ops log, test secret.
VERIFY_STATE_DIR=.state

# Append-only revenue ledger.
VERIFY_LEDGER=.state/ledger.jsonl
